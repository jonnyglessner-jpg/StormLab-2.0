            // never darkens what is behind it (that painted a dark haze with a hard edge under the anvil), and both ends of its
            // extent fade out smoothly
            float shaftFade = (1.0 - ss(0.55, 0.9, lt.g)) * (1.0 - ss(S_base.x - 0.3, S_base.x + 0.5, q.z));
            if (shaftFade > 0.0 && !((uint)_Dbg.x & 16u))
            {
                // 2.0: a fifth of 1.0's haze (the Plains air under these storms is clear for 50+ miles), with the forward
                // peak kept so crepuscular rays still show toward a low sun
                float ks = 0.01 * (1.0 - lt.g) * (1.0 + 4.0 * pow(max(cosg, 0.0), 6.0)) * shaftFade;
                float3 sc = sunz * sunL * (0.25 + 2.4 * pow(max(cosg, 0.0), 6.0)) * 0.9;
                col += T * (1.0 - exp(-ks * dt)) * sc;
            }
            if (inTor)
            {
                float3 tf = tornadoField(q); float2 av = antiTornadoField(q); float2 sat = satelliteField(q);
                float2 tv = float2(max(tf.x, max(av.x, sat.x)), tf.y + av.y + sat.y);
                // the soil it lofts (1.0's brown when the block has none)
                float3 soil = S_tor9.x + S_tor9.y + S_tor9.z > 0.0 ? S_tor9.xyz : float3(0.5, 0.44, 0.37);
                // its own sun test, and the bright horizon it sees all round from under the base (the light grid's sky
                // term is the sky overhead, which the base hides)
                float tsun = (tv.x > 0.0 || tv.y > 0.0) ? max(sunL, tornadoSun(q)) : 0.0;
                float3 hzLight = skyc * 0.2 + hazec * 0.08;
                // the funnel's vertical sides see the horizon under the base, which the base's underside does not (the
                // painted path's version; the physical path takes it from the sky bands below)
                float3 sideLight = skyc * 0.42 + hazec * 0.3;
                if (tv.x > 0.0)
                {
                    // the funnel: a cloud surface (sharp threshold), lit like the cloud base it hangs from, darker low down;
                    // bright white or rain-laden grey by its brightness, stained low down by the dirt it lofts, and a
                    // translucent one is a soft, thin veil
                    float ghost = S_tor8.z;
                    // a wedge's envelope has a soft rim: rain and debris thin it out over its outer tenth or so
                    // Opaque unless it is a ghost: 3.5x the cloud's extinction is optical depth 4 across 30 m, so a rope or
                    // the narrow foot of a cone does not show the horizon through it (1.3x was about 1). A ghost keeps its thin veil
                    float e = 0.06 + 1.5 * g_fp + 0.25 * ghost + (S_tor4.w > 0.5 ? 0.09 : 0.0);
                    float bf = ss(0.3 - e, 0.3 + e, tv.x) * _MP.x * 3.5 * lerp(1.0, 0.067, ghost);
                    float hz = saturate(q.z / max(S_base.x, 0.3));
                    float alb = S_tor8.x > 0.0 ? S_tor8.x : 1.0;
                    float tone = tf.x >= max(av.x, sat.x) ? tf.z : 1.0;
                    // an opaque funnel is a lit surface, not a thin cloud: front-lit (sun behind the viewer) its side faces the
                    // low sun squarely and takes more of it than the base's underside does; back-lit it is a silhouette with a
                    // faint glow at its edges
                    // rounded: the side facing the sun takes it, the side away from it does not, and the funnel darkens a
                    // little toward its edges as seen (limb), where a back-lit one glows faintly instead
                    float2 sH = normalize(_Sun.xy + float2(1e-5, 0.0)), vH = normalize(-rd.xy + float2(1e-5, 0.0));
                    // cs: -1 on the side away from the sun's bearing .. 1 on the side facing it. The terminator is soft (light
                    // diffuses a little way round the edge of a cloud surface) but near 90 degrees, so seen side-on a sunlit
                    // funnel is half white and half grey, and seen from the far side it is grey with a bright rim
                    float cs = dot(g_torN, sH);
                    float lit = saturate((cs + 0.3) / 1.3), facing = abs(dot(g_torN, vH));
                    float limb = lerp(0.72, 1.0, facing);
                    // a wedge's or multiple-vortex envelope is a dark, rain- and debris-laden mass and takes less side light
                    float wedgeK = S_tor4.w > 0.5 ? 0.45 : 1.0;
                    float3 amb;
                    if (phys)
                    {
                        // Out of the sun the funnel's side is lit by the sky it faces, as a vertical Lambertian surface: the
                        // cap at grazing (0.045), the ring (0.24) and the horizon (0.21) of the bands skyLight uses, with the same
                        // visibilities the cloud around it has. The horizon is the part that differs by side: toward the sun's
                        // bearing it is brighter and usually open (the clear slot), away from it dimmer and often behind rain.
                        // The side the viewer sees faces the viewer, so it shows the horizon behind them: a shadowed funnel is
                        // a light grey with the sun behind the viewer and a dark grey silhouette looking toward the sun, never
                        // white. sv.b is the ring's mean visibility and sv.a its visibility toward the sun; between them a
                        // dipole gives the visibility of the half facing each way. The lowest ~13 degrees of the horizon (0.14
                        // of the 0.21), the strip seen under the base's edge, take their visibility from tornadoHorizon
                        // instead, in the direction this side faces.
                        float4 svT = _SkyVis.SampleLevel(sampler_LinearClamp, tc, 0);
                        // blended by the near field's weight, not switched where it starts: a switch drew a seam
                        // across the funnel at the near box's floor
                        float capV = svT.r, sideV = 1.0;
                        if (wN > 0.0) { float4 nlT = _NearLight.SampleLevel(sampler_LinearClamp, nearUvw(q), 0); capV = lerp(capV, nlT.g, wN); sideV = lerp(1.0, nlT.b, wN); }
                        float visN = saturate(svT.b + (svT.a - svT.b) * cs);
                        float3 horL = max(g_hor + (g_horK - g_hor) * cs, 0.6 * g_hor);
                        float3 horN = horL * (0.07 * visN * sideV + 0.14 * tornadoHorizon(q, g_torN));
                        amb = (0.045 * g_zen * capV + (0.24 * g_mid * svT.g * sideV + horN) * wedgeK) * _PL2.x + skyFill() + groundLight(q, sunc);
                        // It is the same cloud as the lowering it hangs from, so in shadow it is never darker than that
                        // cloud's sky light (1.25 undoes the albedo tint below; a wedge may go a little darker)
                        float3 parentSky = 0.5 * (0.18 * g_zen * capV + (0.477 * g_mid * svT.g + 0.342 * horLight(svT)) * sideV) * _PL2.x + skyFill() + groundLight(q, sunc);
                        amb = max(amb, parentSky * (wedgeK < 1.0 ? 1.0 : 1.25));
                    }
                    else
                    {
                        // the side light fades out up the flare, so the funnel blends into the base's tone where they join,
                        // and is the horizon behind the viewer: bright toward the sun, dim away from it
                        float sideK = lerp(1.0, 0.3, ss(0.62, 0.86, hz)) * wedgeK * lerp(0.35, 1.25, 0.5 + 0.5 * cs);
                        amb = skyc * (0.18 + 0.45 * lt.g) + sideLight * sideK;
                    }
                    // (the painted path darkens it low down; the physical one gets that from the horizon it sees)
                    float3 c = (sunz * (tsun * (0.12 + 1.35 * lit + 0.35 * (ph - 0.45) * (1.0 - facing))) + amb * limb) * (phys ? 1.0 : lerp(0.78, 1.0, hz)) + (phys ? 0.0 : bounceC * 0.4);
                    float3 cc = lerp(float3(0.78, 0.8, 0.84) * alb, soil * 0.85, S_tor9.w * pow(saturate(1.0 - hz / 0.45), 2.0)) * tone;
                    // Fade the exposed funnel's cylinder lighting into its parent cloud
                    // over the trumpet flare, using the same light as the near volume.
                    float ztop = max(S_base.x - 0.6 * S_wall2.x, 0.3);
                    float join = ss(ztop * 0.75, ztop * 1.05, q.z) * S_wall.w;
                    float3 parent = phys ? sunz * cloudSun(lt.r, 0.0, 1.0) + skyLight(sv) + groundLight(q, sunc) : c * 0.73;
                    if (phys && wN > 0.0)
                    {
                        float4 nl = _NearLight.SampleLevel(sampler_LinearClamp, nearUvw(q), 0);
                        float3 nearParent = sunz * cloudSun(nl.r, 0.0, 1.0) + 0.5 * (0.18 * g_zen * nl.g + 0.477 * g_mid * sv.g * nl.b + 0.342 * horLight(sv) * nl.b) * _PL2.x + skyFill() + groundLight(q, sunc);
                        parent = lerp(parent, nearParent, wN);
                    }
                    be += bf; Lc += lerp(c * cc, parent, join) * bf;
                }
                if (tv.y > 0.0)
                {
                    // dust and debris: lit like the ground beneath
                    float lit = saturate(0.5 + 0.5 * dot(g_torN, safeNorm(_Sun.xy, float2(1, 0))));
                    float od = 0.5 * tv.y * max(S_tor2.x * S_tor6.w, 0.08);   // (0.5: its shading as calibrated before the denser whirl)
                    float shade = exp(-od * (0.15 + 0.65 * (1.0 - lit)));
                    float3 tl = sunz * tsun * (0.25 + 0.65 * lit) * shade + (skyc * (0.3 + 0.5 * lt.g) + hzLight * 0.8) * (0.65 + 0.35 * shade) + bounceC * 0.3;
                    be += tv.y; Lc += tl * soil * tv.y;
                }
            }
            prevBe = be;
            if (be > 0.0005)
            {
                // Lightning is local scattered radiance, not a change to density or a screen-wide flash.
                // Undo night adaptation here: that gain belongs to faint ambient illumination, not a bright discharge.
                if (_TransientLightOn != 0)
                    Lc += be * _TransientLightTex.SampleLevel(sampler_LinearClamp, tc, 0).rgb / max(_Night.x, 1.0);
                float a = 1.0 - exp(-be * dt);
                float haze = 1.0 - exp(-t / 110.0);
                float3 c = lerp(Lc / be, hazec, ((uint)_Dbg.x & 16u) ? 0.0 : haze * 0.9);
                col += T * a * c;
                dsum += T * a * t; wsum += T * a;
                T *= 1.0 - a;
                if (T < 0.5 && tHalf > 1e8) tHalf = t;
            }
            t += dt;
        }
    }
    // beyond the volume
    if (fa1 > fa0 && boxHit && tBox < tStop) farAnvil(cp, rd, max(fa0, tBox), fa1, skyc, hazec, phys, col, T, dsum, wsum);
    float dist = wsum > 1e-3 ? dsum / wsum : min(tb, 60.0);
    _OutDist[id.xy] = dist;
    _OutHalf[id.xy] = tHalf < 1e8 ? tHalf : dist;
    if ((uint)_Dbg.x & 64u) { _Out[id.xy] = float4(nSteps / _DepthP.w, nDetail / _DepthP.w, T, 0.0); return; }

    bool sceneHit = tScene < 1e8;
    if (_Opt.z > 0.5 && !sceneHit)
    {
        // 1.0's backdrop: farm fields under the storm's shadow, and a sky with a warm horizon toward the sun. 2.0: both
        // follow the sun's colour and height (1.0's colours at its evening sun)
        float3 sunRel = sunc / float3(0.95, 0.779, 0.57);
        float3 bg;
        if (rd.z < 0.0)
        {
            float tg = -cp.z / rd.z; float3 g = cp + rd * tg;
            float sh = 1.0;
            // the storm's shadow: inside the volume from the light grid; outside it, from where the ray toward the sun
            // enters the volume (the evening sun throws the shadow far beyond the volume's edge)
            float3 gs = float3(g.xy, 0.0);
            if (abs(g.x) >= L || abs(g.y) >= L)
            {
                float3 sinv = 1.0 / (abs(_Sun.xyz) > 1e-5 ? _Sun.xyz : 1e-5);
                float3 s0 = (float3(-L, -L, 0.0) - gs) * sinv, s1 = (float3(L, L, ZT) - gs) * sinv;
                float3 smn = min(s0, s1), smx = max(s0, s1);
                float sa = max(max(smn.x, smn.y), max(smn.z, 0.0)), sb = min(min(smx.x, smx.y), smx.z);
                gs = sb > sa ? gs + _Sun.xyz * (sa + 0.05) : float3(1e9, 1e9, 0.0);
            }
            if (abs(gs.x) < L && abs(gs.y) < L) sh = sunT(_Light.SampleLevel(sampler_LinearClamp, float3((gs.x + L) / (2.0 * L), (gs.y + L) / (2.0 * L), max(gs.z / ZT, 0.01)), 0).r);
            float hz = 1.0 - exp(-tg / 70.0);
            float2 gp = g.xy + _Opt.xy;
            bg = groundColor(gp, tg) * (0.4 * skyK + 0.42 * sh * float3(1.05, 0.95, 0.82) * sunRel) * (1.0 - hz) + hazec * hz * 0.85;
        }
        else
        {
            bg = skyRad(rd, warm, glowK, skyK);
        }
        float3 cc = nightGrade(col + T * bg);
        _Out[id.xy] = float4(_Opt.w > 0.5 ? toneMap(cc) : cc * _MP.z, 0.0);
    }
    else
    {
        col = nightGrade(col);
        _Out[id.xy] = float4(_Opt.w > 0.5 ? toneMap(col) : col * _MP.z, T);
    }
}

// ------------------------------------------------------------------------------------------------ temporal resolve
Texture2D<float4> _Cur;
Texture2D<float> _CurDist;
Texture2D<float4> _Hist;
RWTexture2D<float4> _ResolveOut;
// previous camera in the current volume frame
float4 _PrevPos, _PrevFwd, _PrevRight, _PrevUp;

[numthreads(8, 8, 1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Res.x || id.y >= (uint)_Res.y) return;
    int2 hi = int2(_Res.xy) - 1;
    float4 cur, mn, mx; float curD;
    bool cb = _TP.y > 0.5;
    bool marched = !cb || ((id.x + id.y + (uint)_MP.w) & 1u) == 0u;
    if (!cb)
    {
        cur = _Cur[id.xy]; curD = _CurDist[id.xy]; mn = cur; mx = cur;
        for (int dy = -1; dy <= 1; dy++)
            for (int dx = -1; dx <= 1; dx++)
            {
                float4 c = _Cur[clamp(int2(id.xy) + int2(dx, dy), 0, hi)]; mn = min(mn, c); mx = max(mx, c);
            }
    }
    else
    {
        // checkerboard: only this frame's parity is fresh. A marched pixel clamps against itself and its diagonals; a
        // skipped one is the mean of its four marched neighbours, clamped against them
        int2 o4[4] = { int2(1, 0), int2(-1, 0), int2(0, 1), int2(0, -1) };
        int2 d4[4] = { int2(1, 1), int2(-1, 1), int2(1, -1), int2(-1, -1) };
        if (marched)
        {
            cur = _Cur[id.xy]; curD = _CurDist[id.xy]; mn = cur; mx = cur;
            [unroll] for (int k = 0; k < 4; k++) { float4 c = _Cur[clamp(int2(id.xy) + d4[k], 0, hi)]; mn = min(mn, c); mx = max(mx, c); }
        }
        else
        {
            cur = 0.0; curD = 0.0; mn = 1e9; mx = -1e9;
            [unroll] for (int k = 0; k < 4; k++)
            {
                int2 q = clamp(int2(id.xy) + o4[k], 0, hi);
                float4 c = _Cur[q]; cur += c; curD += _CurDist[q]; mn = min(mn, c); mx = max(mx, c);
            }
            cur *= 0.25; curD *= 0.25;
        }
    }
    // a skipped pixel trusts its history more: its new value is only an interpolation
    float a = marched ? _TP.x : (_TP.x < 0.999 ? _TP.x * 0.5 : 1.0);
    if (a < 0.999)
    {
        float2 uv = (float2(id.xy) + 0.5) * _Res.zw;
        float2 ndc = uv * 2.0 - 1.0;
        float3 rd = normalize(_CamFwd.xyz + ndc.x * _CamTan.x * _CamRight.xyz + ndc.y * _CamTan.y * _CamUp.xyz);
        float3 P = _CamPos.xyz + rd * curD;
        float3 v = P - _PrevPos.xyz; float z = dot(v, _PrevFwd.xyz);
        if (z > 1e-3)
        {
            float2 pn = float2(dot(v, _PrevRight.xyz) / (z * _CamTan.x), dot(v, _PrevUp.xyz) / (z * _CamTan.y));
            float2 puv = pn * 0.5 + 0.5;
            if (all(puv > 0.0) && all(puv < 1.0))
            {
                float4 h = _Hist.SampleLevel(sampler_LinearClamp, puv, 0);
                h = clamp(h, mn, mx);
                cur = lerp(h, cur, a);
            }
        }
    }
    _ResolveOut[id.xy] = cur;
}
