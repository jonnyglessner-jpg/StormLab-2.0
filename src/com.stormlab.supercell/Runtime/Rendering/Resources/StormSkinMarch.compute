            float3 q = cp + rd * t; nSteps++;
            g_fp = t * pixA;
            float dt = dt0 * (1.0 + t / 50.0);
            float3 tc = uvw(q);
            float4 s = _Dens.SampleLevel(sampler_LinearClamp, tc, 0);
            // Away from the storm the canopy is a slowly changing sheet: there it takes the same analytic shape the far
