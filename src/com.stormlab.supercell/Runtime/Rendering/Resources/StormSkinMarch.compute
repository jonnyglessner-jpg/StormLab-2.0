        // every view's march ~15 %, tornado or not (register pressure, by the look of it).
        float trIn = 1e9, trOut = -1e9;
        if (torOn && S_tor.z > 0.0)
        {
            float2 o = cp.xy - 0.5 * (S_tor.xy + S_tor3.xy); float torR = tornadoBound();
            float qa = dot(rd.xy, rd.xy), qb = dot(o, rd.xy), qc = dot(o, o) - torR * torR, disc = qb * qb - qa * qc;
            float c0 = ta, c1 = tb;
            if (qa > 1e-8) { float sq = sqrt(max(disc, 0.0)); c0 = max(c0, (-qb - sq) / qa); c1 = disc > 0.0 ? min(c1, (-qb + sq) / qa) : -1.0; }
            else if (qc > 0.0) c1 = -1.0;
            if (rd.z > 1e-6) c1 = min(c1, (torTop - cp.z) / rd.z);
            else if (rd.z < -1e-6) c0 = max(c0, (torTop - cp.z) / rd.z);
            else if (cp.z >= torTop) c1 = -1.0;
            float tt = c0;
