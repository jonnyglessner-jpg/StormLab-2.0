            else if (t < trIn) dt = min(dt, max(trIn - t, 0.006) + 0.004);   // coming down from above it
            // the last step ends at the volume's edge, where the far anvil's march takes over (no stretch counted twice)
            dt = min(dt, max(tb - t, 0.002));
            float be = 0.0; float3 Lc = 0.0;
            bool lowQ = q.z < S_base.x + 0.3;
            float4 lt = (s.r > 0.004 || s.g > 0.2 || nearOn || lowQ) ? _Light.SampleLevel(sampler_LinearClamp, tc, 0) : float4(0, 1, 1, 1);
