// The storm volume (DESIGN.md 2.5): BUILD paints the designed storm into a target volume (1.0's BUILD pass),
// ADVECT carries the live volume with the simulated wind and relaxes it toward the target, LIGHT computes sun and sky
// light on a coarse grid (1.0's LIGHT pass), SKYVIS how much of the sky each light-grid point sees and GROUNDLIGHT how
// lit the ground under the storm is (the march's sky and ground light), WIND reduces the model's C-grid wind to 2 km
// blocks for the timeline of winds. Volume texel: r = cloud, g = precipitation, b = near-ground features (shadows only), a = material
// (water 0.3 + 0.7 * turbulence, ice 0.3 * (1 - ice)).
#pragma kernel Build
#pragma kernel Advect
#pragma kernel Light
#pragma kernel SkyVis
#pragma kernel GroundLight
#pragma kernel Wind

#include "Packages/com.stormlab.supercell/Runtime/Rendering/Shaders/StormSkinCommon.hlsl"

RWTexture3D<float4> _OutD;
Texture3D<float4> _DensIn;
Texture3D<float4> _Target;
// x: dt s, y: relaxation toward the target 0..1, zw: volume-centre shift since the last frame (km, new - old)
float4 _AdvP;


// a cumulus congestus tower: centre c, radius R, base zb, top zt. Near-vertical sides, a rounded top
float congestus(float3 p, float2 c, float R, float zb, float zt, float seed)
{
    float r = length(p.xy - c);
    if (r > R * 2.2 || p.z > zt + R * 1.2 || p.z < zb - 0.3) return 0.0;
    float3 ps = p / max(R, 0.4) + float3(seed * 3.7, seed * 1.9, seed * 5.3);
    float n = 0.62 * n3(ps * 0.3) + 0.38 * n3(ps * 0.7 + float3(0.3, 0.6, 0.1)) - 0.5;
    float hz = saturate((p.z - zb) / max(zt - zb, 0.3));
    float edge = R * (0.95 - 0.35 * hz * hz) + n * R * 0.8;
    float top = zt - 1.1 * R * pow(min(r / max(R, 0.1), 1.4), 2.0) + n * R * 1.0;
    float zbt = zb + 0.15 * clamp(r / max(R, 0.1), 0.0, 1.2) + n * 0.3;
    return ss(0.45, -0.45, r - edge) * ss(zbt - 0.15, zbt + 0.3, p.z) * ss(top + 0.25, top - 0.45, p.z);
}

float3 voxelPos(uint3 id)
{
    float L = S_grid.z; float ZT = S_grid.w;
    return float3(-L + (id.x + 0.5) * 2.0 * L / S_grid.x, -L + (id.y + 0.5) * 2.0 * L / S_grid.x, (id.z + 0.5) * ZT / S_grid.y);
}
float3 uvwOf(float3 p) { float L = S_grid.z; return float3((p.x + L) / (2.0 * L), (p.y + L) / (2.0 * L), p.z / S_grid.w); }

[numthreads(4, 4, 4)]
void Build(uint3 gid : SV_DispatchThreadID)
{
    uint nv = (uint)S_grid.x; uint nz = (uint)S_grid.y;
    uint3 id = uint3(gid.x, gid.y, gid.z + (uint)S_slab.x);
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float3 p = voxelPos(id);
    float2 fw = S_f.xy; float2 lf = S_f.zw; float zb = S_base.x; float el = S_base.y; float tmin = S_base.w;
    float otTop = el + max(S_ot.z, 0.0) + 1.0;
    if (p.z > max(el + 2.5, otTop)) { _OutD[id] = float4(0.0, 0.0, 0.0, water(1.0)); return; }
    float cloud = 0.0; float rain = 0.0;
    float mw = 1e-4; float ms = 1e-4 * water(1.0);
    float R = S_tower.y; float zt = S_tower.x;
    float zr = p.z - zb;

    // ---- main updraft: low down the rotating updraft (mesocyclone), a broad, upright barrel with a tucked rim; higher up
    // the convective tower, widening into the anvil's root. Shape from StormLab 1.0 as live (2030265)
    float2 c = mesoCentre(zr);
    float2 d = p.xy - c; float r = length(d);
    if (S_tower.z > 0.0 && r < R * 3.5 + 6.0)
    {
        float H = max(zt - zb, 0.5);
        float hz = saturate(zr / H);
        float lam = saturate(1.7 * S_tower.w) * (1.0 - ss(4.0, 7.5, zr));
        float young = 1.0 - saturate(S_anvil.w);
        float flare = baseFlare(zr);
        // the rising column broadens continuously as its rise turns into outflow under the tropopause: one smooth root
        float upperMerge = ss(el - 5.0, el - 0.8, p.z) * saturate(S_anvil.w);
        float trumpet = 1.85 * upperMerge * upperMerge;
        float rad0 = R * lerp(1.0, 0.8, young) * (1.0 + flare - 0.22 * S_tower.w * ss(0.05, 0.35, hz) + lerp(0.25 * ss(0.4, 0.8, hz) + trumpet, -0.3 * hz * hz, young));
        float rad = rad0 + mesoExtra(zr) + mesoShoulder(d, zr);
        float n = fbm(p) - 0.5;
        float lump = lerp(0.5, 1.7, ss(1.0, 5.0, zr)) * (1.0 - 0.75 * lam);
        float edge = rad + n * 2.2 * lump;
        float dome = lerp(lerp(0.9 * rad, 2.2, saturate(S_anvil.w)), 0.45, upperMerge);
        float top = zt - dome * pow(min(r / max(rad, 0.1), 1.5), 2.0) + n * lerp(lerp(1.1, 2.4, young), 0.7, upperMerge);
        float ew = 0.55 + 0.05 * R * (0.9 * S_tower.w + 0.12) * exp(-max(zr, 0.0));
        float nb = n3(p * 0.45 + float3(0.3, 0.8, 0.5)) - 0.5;
        // the underside: lifted a little above the LCL while the updraft rotates (the lowerings hang below it) and rolling
        // up toward the rim; the side and the underside meet in a rounded corner, not a knife edge
        float zbase = zb + baseLift() + underbellyRise(p.xy - mesoCentre(0.0)) + nb * 0.3;
        float2 corner = float2(r - edge + 0.5, zbase - p.z + 0.5);
        float rounded = length(max(corner, 0.0)) + min(max(corner.x, corner.y), 0.0) - 0.5;
        float tw = ss(ew, -ew, rounded) * ss(top + 0.3, top - 0.6, p.z);
        // overshooting top: a dome above the anvil whose height follows the simulated cloud top above the anvil
        float oh = S_ot.z;
        if (oh > 0.05)
        {
            float2 od2 = (p.xy - S_ot.xy) / max(S_ot.w, 0.5);
            float od = length(float3(od2, (p.z - el) / max(oh, 0.2)));
            tw = max(tw, ss(1.0, 0.65, od + n * 0.3) * ss(el - 1.5, el - 0.4, p.z));
        }
        float tv = S_tower.z * tw;
        // a young tower is a cluster of turrets, each a towering cumulus of its own, merging into one
        if (young > 0.02)
        {
            for (uint j = 0; j < 3; j++)
            {
                float fj = (float)j;
                float a = 2.1 * fj + 0.7; float2 o = float2(cos(a), sin(a)) * R * (0.62 + 0.1 * fj);
                float hj = (zt - zb) * (1.02 - 0.2 * fj);
                tv = max(tv, S_tower.z * young * congestus(p, c + o * (1.0 + 0.08 * max(zr, 0.0)), R * (0.48 - 0.05 * fj), zb, zb + hj, 11.0 + fj * 3.0));
            }
        }
        mw += tv * tv; ms += tv * tv * water(lerp(1.0, 0.12, lam));
        cloud = max(cloud, tv);
    }

    // forward flank: precipitation only, no separate low or mid-level cloud body (as live)

    // ---- inflow: warm, moist air rising as a smooth, banded ramp into the side of the mesocyclone
    if (S_tail.w > 0.0)
    {
        float2 t0 = S_up.xy + S_f.xy * 2.5 + S_f.zw * 0.5;
        float2 td = S_tail.xy; float2 tn = float2(-td.y, td.x);
        float sT = dot(p.xy - t0, td) + R * 0.6;
        float qT = dot(p.xy - t0, tn) - 0.035 * (S_tail.z - sT) * (S_tail.z - sT) * 0.12;
        if (sT > -3.0 && sT < S_tail.z && abs(qT) < 6.0 && p.z < zb + 5.0)
        {
            float rise = 1.0 - ss(-2.0, S_tail.z * (10.0 / 11.0), sT);
            float nI = fbm(p * 1.3 + float3(1.7, 0.4, 2.2)) - 0.5;
            float topI = zb + 0.9 + 3.4 * rise + nI * 0.4;
            float botI = zb - 0.04 + 0.25 * (1.0 - rise) + nI * 0.15;
            float wI = (1.0 + 2.2 * rise) * (0.8 + 0.4 * nI);
            float band = 0.85 + 0.15 * sin(6.2832 * (p.z - zb) / 0.45 + sT * 0.4);
            float iv = S_tail.w * 0.9 * ss(wI + 0.4, wI - 0.6, abs(qT)) * ss(botI - 0.1, botI + 0.2, p.z) * ss(topI + 0.3, topI - 0.5, p.z)
                * ss(-3.0, -1.0, sT) * (1.0 - ss(S_tail.z * (8.0 / 11.0), S_tail.z, sT)) * band;
            mw += iv * iv; ms += iv * iv * water(0.15);
            cloud = max(cloud, iv);
        }
    }

    // ---- anvil (anvilAt, shared with the march, which draws it beyond the volume); mammatus hang beneath it downwind
    {
        AnvilS an = anvilAt(p);
        float av = an.av; float inPlan = an.inPlan; float botz = an.botz; float fr = an.fr; float lens = an.lens;
        if (an.inPlan > 0.0)
        {
            mw += av * av; ms += av * av * an.mat;
            cloud = max(cloud, av);
            // mammatus: rounded pouches on a jittered 2.2 km grid hanging from the anvil's underside downwind. 1.0
            // switched them off at 350 m voxels; at 150 m they resolve. Depth from the designer (ice at the anvil base)
            if (S_anvil2.z > 0.0 && fr > 0.03 && fr < 0.7)
            {
                float cs = 2.2;
                float2 gg = p.xy / cs; float2 gi = floor(gg);
                float dep = 0.0;
                for (int oy = -1; oy <= 1; oy++)
                {
                    for (int ox = -1; ox <= 1; ox++)
                    {
                        float2 cc = gi + float2(ox, oy);
                        float h1 = hash1(cc.x * 17.3 + cc.y * 91.7); float h2 = hash1(cc.x * 43.1 + cc.y * 7.9); float h3 = hash1(cc.x * 5.7 + cc.y * 61.3);
                        float2 ctr = (cc + float2(0.2 + 0.6 * h1, 0.2 + 0.6 * h2)) * cs;
                        float rr = cs * (0.34 + 0.2 * h3);
                        float dd = length(p.xy - ctr) / rr;
                        dep = max(dep, (1.0 - dd * dd) * step(0.3, h3) * step(dd, 1.0));
                    }
                }
                float bandM = ss(0.03, 0.12, fr) * (1.0 - ss(0.45, 0.7, fr)) * lens;
                float depth = max(S_mamm.w, 0.2) * 1.4 * S_anvil2.z * bandM * dep;
                float mv = 0.85 * inPlan * ss(botz - depth - 0.12, botz - depth + 0.15, p.z) * (1.0 - ss(botz + 0.05, botz + 0.3, p.z)) * ss(0.02, 0.1, depth);
                mw += mv * mv; ms += mv * mv * icy(0.95);
                cloud = max(cloud, mv);
            }
        }
    }

    // ---- flanking line along the rear-flank gust front, tops stepping down from the main updraft
    if (S_flank.z > 0.0)
    {
        float2 fd = S_flank.xy; float2 rn = float2(fd.y, -fd.x);
        float fm = S_late.x;
        float reach = 0.0;
        for (uint k = 0; k < 8; k++)
        {
            if ((float)k >= S_flank.w) break;
            float fk = (float)k;
            float h1 = hash1(fk * 7.31 + 1.3); float h2 = hash1(fk * 3.97 + 0.4); float h3 = hash1(fk * 5.13 + 2.2);
            float dist = R * 0.8 + 1.6 + fk * (2.7 + 0.9 * fm) + (h1 - 0.5) * 1.4;
            float2 ctr = S_up.xy + fd * dist + rn * (0.03 * dist * dist + (h2 - 0.5) * 1.3);
            float grow = saturate(S_flank.z * 1.7 - fk * 0.1);
            float life = 0.86 + 0.14 * sin(tmin * 0.3 + fk * 1.9);
            float Hk = 1.08 * (zt - zb) * (0.5 - 0.06 * fk) * (0.55 + 0.8 * h3) * grow * life * (1.0 + 0.5 * fm);
            if (Hk < 0.25) continue;
            reach = max(reach, dist);
            float rk = 1.12 * (2.3 - 0.17 * fk) * (0.75 + 0.45 * h1) * (0.65 + 0.35 * grow) * (1.0 + 0.6 * fm);
            float2 lean = -fd * 0.16 * max(zr, 0.0);
            float fv = congestus(p, ctr + lean, rk, zb, zb + Hk, fk + 0.37);
            float2 off = float2(h2 - 0.5, h3 - 0.5) * rk * 1.5;
            fv = max(fv, congestus(p, ctr + off + lean * 0.8, rk * 0.65, zb, zb + Hk * (0.5 + 0.45 * h1), fk + 4.1));
            float2 off2 = float2(h1 - 0.5, 0.5 - h2) * rk * 1.6;
            fv = max(fv, congestus(p, ctr + off2 + lean * 0.9, rk * 0.5, zb, zb + Hk * (0.35 + 0.5 * h2), fk + 8.3));
            mw += fv * fv; ms += fv * fv * water(1.0);
            cloud = max(cloud, fv);
        }
        float2 rel = p.xy - S_up.xy; float al = dot(rel, fd);
        float offs = dot(rel, rn) - 0.03 * al * al;
        if (reach > 0.0 && abs(offs) < 2.5 * (1.0 + 0.6 * fm) && al > 0.0 && al < reach + 1.0 && p.z < zb + 1.6)
        {
            float nb = n3(p * 0.7 + float3(0.9, 0.3, 0.1)) - 0.5;
            float sh = ss(1.22 * (1.0 + 0.6 * fm), 0.55, abs(offs) + nb * 0.8) * ss(R * 0.5, R + 0.5, al) * ss(reach - 0.5, reach - 2.5, al)
                * ss(zb - 0.1 + nb * 0.3, zb + 0.3 + nb * 0.3, p.z) * ss(zb + 0.8 + nb * 0.4, zb + 0.35, p.z) * 0.7;
            mw += sh * sh; ms += sh * sh * water(0.6);
            cloud = max(cloud, sh);
        }
    }

    // ---- a continuous apron rising from the horseshoe into the rotating barrel: its centre and radius converge on the
    // updraft with height, instead of separate towers on the gust front
    if (S_rfdb.w > 0.0 && zr > -0.2 && zr < 3.5)
    {
        float join = ss(0.0, 3.0, zr);
        float2 ac = lerp(S_rfdb.xy, mesoCentre(zr), join);
        float ar = lerp(S_rfdb.z + 0.45, R + mesoExtra(zr), join);
        float2 db = p.xy - S_rfdb.xy;
        float th = atan2(dot(db, lf), dot(db, fw));
        float arc = lerp(horseshoeArc(th), 1.0, join);
        float inner = lerp(ss(S_rfdb.z * 0.55, S_rfdb.z * 0.85, length(db)), 1.0, join);
        float n = fbm(p) - 0.5;
        float apronBase = zb + baseLift() + underbellyRise(p.xy - mesoCentre(0.0));
        float apron = S_rfdb.w * arc * inner * ss(ar + 0.5, ar - 0.5, length(p.xy - ac) + n * 0.35)
            * ss(apronBase - 0.15, apronBase + 0.35, p.z) * ss(3.5, 2.5, zr);
        mw += apron * apron; ms += apron * apron * water(0.12);
        cloud = max(cloud, apron);
    }

    float nearV = nearField(p, 0.0);

    // ---- precipitation: streaky curtains under the forward flank, a hail core next to the updraft, hook rain
    float below = ss(zb + 1.2, zb - 0.3, p.z);
    // Live 1.0 carries the forward-flank and hail shafts up into the anvil, where its storm cloud hides their top. The
    // brain's forward-flank core is far bigger (its hail aloft is a known bias) and 2.0 has no cloud body round it, so
    // there they would stand as a grey wall: the shafts start at the cloud base, as before
    float forwardBelow = below;
    float curt = 0.0;
    if (below > 0.0)
    {
        curt = (0.35 + 0.65 * ss(0.3, 0.7, n3(float3(p.x * 0.11 + p.z * 0.01, p.y * 0.11, p.z * 0.02))))
            * (0.55 + 0.6 * n3(float3(p.x * 0.45, p.y * 0.45, p.z * 0.04) + float3(0.3, 0.5, 0.1)));
    }
    if (S_ffd.w > 0.0 && forwardBelow > 0.0)
    {
        float reachF = zb * (1.0 - saturate(S_ffd.w * 1.6));
        float2 fq = p.xy - S_ffd.xy;
        float2 rq;
        // 2.0: the simulated core's own ellipse when there is one; otherwise 1.0's, swept out mostly east (live)
        if (S_ffd2.z > 0.0) { float2 ax = S_ffd2.xy; rq = float2(dot(fq, ax) / S_ffd2.z, dot(fq, float2(-ax.y, ax.x)) / S_ffd2.w); }
        else
        {
            rq = float2(dot(fq, fw) / (6.0 * S_ffd.z), dot(fq, lf) / (4.0 * S_ffd.z));
            float2 ext = float2(7.5, 2.5) * S_ffd.z * saturate(S_ffd.w) * ss(0.0, 0.02, S_tilt.w);
            float2 sweep = float2(dot(ext, fw) / (6.0 * S_ffd.z), dot(ext, lf) / (4.0 * S_ffd.z));
            float along = saturate(dot(rq, sweep) / max(dot(sweep, sweep), 1e-4));
            rq -= sweep * along;
        }
        // late in the storm (S_up.w) the straight-down forward-flank rain is lighter, lighter still near the tornado
        float lateFfd = (1.0 - 0.45 * S_up.w) * lerp(1.0, ss(2.5, 7.5, length(p.xy - S_wall.xy)), S_up.w);
        rain = max(rain, S_ffd.w * lateFfd * exp(-dot(rq, rq)) * curt * forwardBelow * ss(reachF - 0.2, reachF + 0.3, p.z));
    }
    if (S_hail.w > 0.0 && forwardBelow > 0.0)
    {
        float reachH = zb * (1.0 - saturate(S_hail.w * 1.6));
        float hq = length(p.xy - S_hail.xy) / S_hail.z; float hh = exp(-hq * hq) * curt * forwardBelow * ss(reachH - 0.2, reachH + 0.3, p.z);
        rain = max(rain, S_hail.w * hh * 0.9);
    }
    if (S_rfdb.z > 0.0 && below > 0.0)
    {
        float2 db = p.xy - S_rfdb.xy; float rb = length(db); float Rs = S_rfdb.z;
        float th = atan2(dot(db, lf), dot(db, fw));
        float nsl = n3(float3(p.x * 0.35, p.y * 0.35, p.z * 0.25) + float3(0.7, 0.7, 0.1)) - 0.5;
        float hook = max(ss(-0.25, 0.55, cos(th - 1.9)), S_rfd.w);
        float ring = ss(Rs * 0.45, Rs * 0.8, rb + nsl * 0.8) * ss(Rs * 1.15, Rs * 0.92, rb + nsl * 0.6);
        // the curtain thins out as it curls round toward the tornado at the wall cloud
        float torTaper = ss(0.3 * Rs, 2.4 * Rs, length(p.xy - S_wall.xy));
        rain = max(rain, S_rfd.z * ring * hook * torTaper * curt * below * 0.6);
    }
    // 2.0: the simulated hook / RFD rain core
    if (S_rcore.w > 0.0 && below > 0.0)
    {
        float hq = length(p.xy - S_rcore.xy) / max(S_rcore.z, 0.5);
        float reachR = zb * (1.0 - saturate(S_rcore.w * 1.6));
        rain = max(rain, S_rcore.w * 0.7 * exp(-hq * hq) * curt * below * ss(reachR - 0.2, reachR + 0.3, p.z));
    }

    // one clear slot through every cloud feature, applied last so nothing plugs its rear opening; rain falls through it
    cloud *= 1.0 - clearSlot(p);
    // the forward-flank rain curls round the updraft into the clear slot: a curtain following a spiral from the
    // forward-flank core, anticlockwise round the left and rear of the updraft, thinning as it nears the wall cloud
    float slotWrap = ss(0.05, 0.5, S_rfd.x);
    if (S_ffd.w > 0.0 && slotWrap > 0.0)
    {
        float2 dU = p.xy - S_up.xy;
        float phi = atan2(dot(dU, lf), dot(dU, fw));
        float psi = phi < -0.35 ? phi + 6.2832 : phi;
        float sp = saturate((psi - 0.65) / 3.15);
        float r0 = lerp(max(length(S_ffd.xy - S_up.xy), 3.0), 0.9 * S_tower.y, sp * sp * (3.0 - 2.0 * sp));
        float wid = lerp(2.6, 1.5, sp);
        float drr = (length(dU) - r0) / wid;
        float towardTor = 1.0 - ss(2.8, 3.9, psi);
        float arcW = ss(0.45, 0.8, psi) * towardTor * exp(-drr * drr);
        float reachW = zb * (1.0 - saturate(S_ffd.w * 1.6));
        float hgt = lerp(forwardBelow, below, sp);
        rain = max(rain, 0.9 * (1.0 + 0.3 * S_up.w) * S_ffd.w * slotWrap * arcW * curt * hgt * ss(reachW - 0.2, reachW + 0.3, p.z));
    }

    _OutD[id] = float4(sqrt(saturate(cloud)), sqrt(saturate(rain)), sqrt(saturate(nearV)), ms / mw);
}

// ------------------------------------------------------------------------------------------------ advection
[numthreads(4, 4, 4)]
void Advect(uint3 id : SV_DispatchThreadID)
{
    uint nv = (uint)S_grid.x; uint nz = (uint)S_grid.y;
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float3 p = voxelPos(id);
    float4 tgt = _Target[id];
    float3 wind = windAt(p);
    float dtk = _AdvP.x / 1000.0;
    float3 shift = float3(_AdvP.zw, 0.0);
    float3 pc = p - wind * dtk + shift;
    float3 pr = p - float3(wind.xy, wind.z - _VolC.z) * dtk + shift;
    float3 uc = uvwOf(pc), ur = uvwOf(pr);
    bool inC = all(uc >= 0.0) && all(uc <= 1.0);
    bool inR = all(ur >= 0.0) && all(ur <= 1.0);
    float4 old = inC ? _DensIn.SampleLevel(sampler_LinearClamp, uc, 0) : tgt;
    float oldR = inR ? _DensIn.SampleLevel(sampler_LinearClamp, ur, 0).g : tgt.g;
    float k = _AdvP.y;
    // Anvil ice follows its painted shape closely: its extent is already the brain's measured ice, and advecting a veil
    // a few voxels thick every few frames smears it away faster than a 60 s relaxation restores it (the late canopy
    // vanished). Water cloud keeps the slow relaxation, so it moves with the simulated wind.
    float iceT = (1.0 - saturate(tgt.a / 0.3)) * step(0.01, tgt.r);
    float iceO = (1.0 - saturate(old.a / 0.3)) * step(0.01, old.r);
    float kc = lerp(k, max(k, 0.5), max(iceT, iceO));
    float4 o;
    o.r = lerp(old.r, tgt.r, kc);
    o.g = lerp(oldR, tgt.g, k);
    o.b = tgt.b;
    o.a = lerp(old.a, tgt.a, kc);
    _OutD[id] = o;
}

// ------------------------------------------------------------------------------------------------ light
RWTexture3D<float4> _OutL;
Texture3D<float4> _Dens;
// sun.xyz; dims: light-grid N, NZ, L km, ZT km; p: cloud max, rain max, step km, cloud base km; slab: x first z
float4 _LSun, _LDims, _LP, _LSlab;

float3 luvw(float3 p) { return float3((p.x + _LDims.z) / (2.0 * _LDims.z), (p.y + _LDims.z) / (2.0 * _LDims.z), p.z / _LDims.w); }
float dr(float3 p) { return _Dens.SampleLevel(sampler_LinearClamp, luvw(p), 0).r; }
float betaL(float3 p) { float4 d = _Dens.SampleLevel(sampler_LinearClamp, luvw(p), 0); return (d.r * d.r + d.b * d.b) * _LP.x + d.g * d.g * _LP.y; }

[numthreads(4, 4, 4)]
void Light(uint3 gid : SV_DispatchThreadID)
{
    uint nv = (uint)_LDims.x; uint nz = (uint)_LDims.y;
    uint3 id = uint3(gid.x, gid.y, gid.z + (uint)_LSlab.x);
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float dx = 2.0 * _LDims.z / _LDims.x; float dz = _LDims.w / _LDims.y;
    float3 pos = float3(-_LDims.z + (id.x + 0.5) * dx, -_LDims.z + (id.y + 0.5) * dx, (id.z + 0.5) * dz);
    float4 here = _Dens.SampleLevel(sampler_LinearClamp, luvw(pos), 0);
    float ice = 1.0 - saturate(here.a / 0.3);
    float zb = _LP.w;
    float st = _LP.z;
    float tau = 0.0; float3 q = pos + _LSun.xyz * 0.5 * st;
    // the steps lengthen with distance (live 1.0): a ray from the ground must climb the whole volume to reach the anvil,
    // or the anvil's shadow stops short with a hard edge
    for (int i = 0; i < 64; i++)
    {
        if (q.z > _LDims.w || abs(q.x) > _LDims.z || abs(q.y) > _LDims.z) break;
        float st2 = st * (1.0 + 0.06 * i);
        tau += betaL(q) * st2; q += _LSun.xyz * st2;
    }
    // beyond the volume's side: the far anvil (anvilAt, analytic) along the rest of the ray, so a canopy spread past the
    // volume's edge still shades the storm under it (a low sun shines in under a late anvil from 30-90 km away)
    if (S_anvil.w > 0.0 && q.z <= _LDims.w)
    {
        // short steps first: a ray leaving the volume inside a thin canopy is out of it within a km or so, and one long
        // first step charged it 2.5 km of ice (a dark band along the volume's edge); then long steps for far canopy
        [loop] for (int j = 0; j < 20; j++)
        {
            if (q.z > S_anvil2.y + 1.0) break;
            float st3 = j < 8 ? 0.6 : 2.5;
            tau += anvilAt(q + _LSun.xyz * 0.5 * st3).av * _LP.x * st3; q += _LSun.xyz * st3;
        }
    }
    // 1.0's local self-shadow (it dimmed the transmittance by up to half) as extra depth on the main lobe
    if (ice < 0.2) tau -= log(1.0 - 0.5 * saturate((dr(pos + _LSun.xyz * 0.9) - 0.3) * 2.0)) / 0.38;
    float up = 0.0; float3 r = pos + float3(0.0, 0.0, dz);
    for (int k2 = 0; k2 < 24; k2++) { if (r.z > _LDims.w) break; up += betaL(r) * 2.0 * dz; r.z += 2.0 * dz; }
    float vUp = dr(pos + float3(0.0, 0.0, 0.5));
    float skyOcc = 1.0 - 0.75 * (1.0 - ss(zb + 2.0, zb + 4.0, pos.z)) * saturate((vUp - 0.3) * 2.2);
    float iceShade = 1.0;
    if (ice > 0.05)
    {
        float above = saturate((dr(pos + float3(0.0, 0.0, 0.6)) - 0.1) * 3.0) * 0.55 + saturate((dr(pos + float3(0.0, 0.0, 1.5)) - 0.1) * 3.0) * 0.45;
        float sunward = saturate((dr(pos + _LSun.xyz * 1.2) - 0.1) * 3.0) * 0.55 + saturate((dr(pos + _LSun.xyz * 3.0) - 0.1) * 3.0) * 0.45;
        float ua = 0.0; float dn = 0.0;
        for (int k = 0; k < 4; k++)
        {
            float3 o = float3(cos(k * 1.571), sin(k * 1.571), 0.0) * 1.2;
            ua += dr(pos + o + float3(0.0, 0.0, 1.0)); dn += dr(pos + o - float3(0.0, 0.0, 1.0));
        }
        float under = ss(0.0, 0.4, (ua - 1.5 * dn) * 0.25);
        iceShade = (1.0 - 0.8 * sunward) * (1.0 - 0.8 * under) * (1.0 - 0.3 * above);
    }
    // Away from the storm the canopy is lit as the march's far anvil lights it (the ice between the point and the
    // canopy's top along the sun, no sideways shade probes: on a thin, flat sheet under a low sun those probes hit the
    // sheet itself and darkened it), blending in 3-5 updraft radii out, so the volume and the far anvil meet seamlessly
    if (S_anvil.w > 0.0 && pos.z > S_anvil2.y - 4.0 && pos.z < S_anvil2.y + 1.5)
    {
        float2 aC = S_up.xy + S_tilt.xy * (S_base.y - S_base.x);
        float wA = ss(3.0 * S_tower.y, 5.0 * S_tower.y, length(pos.xy - aC));
        if (wA > 0.01)
        {
            AnvilS a = anvilAt(pos);
            if (a.av > 0.004)
            {
                float est = a.av * _LP.x * min(max(a.topz - pos.z, 0.0) / max(_LSun.z, 0.08), 25.0) * 0.5;
                tau = lerp(tau, est, wA); iceShade = lerp(iceShade, 1.0, wA);
            }
        }
    }
    // r: the sun's optical depth (sunT in StormSkinCommon.hlsl turns it into 1.0's transmittance)
    _OutL[id] = float4(tau, exp(-0.1 * up), skyOcc, iceShade);
}

// ------------------------------------------------------------------------------------------------ sky visibility
// How much of the sky a light-grid point sees, in four parts, for the march's sky light: r the cap within 35 degrees
// of the zenith, g the ring 35-70 degrees from it, b the horizon ring (the light that reaches under a cloud base from
// the side) and a the horizon weighted toward the sun's or moon's bearing (the bright side at sunset). 19 cone traces
// through the live volume (zenith and 4 at 25 degrees; 6 at 50; 8 at 82, 8 degrees above the horizon), 8 steps each
// growing 1.6x from 0.25 km (17.5 km). Optical depth becomes visibility as exp(-0.1 tau), 1.0's sky-from-above rate:
// skylight diffuses into cloud more deeply than direct sun. The march (skyBands) uses the same directions.
RWTexture3D<float4> _OutS;

float skyTrace(float3 p, float3 d)
{
    float tau = 0.0, a = 0.0, s = 0.25;
    [unroll] for (int k = 0; k < 8; k++)
    {
        float3 q = p + d * (a + 0.5 * s);
        if (q.z > _LDims.w || q.z < 0.0 || abs(q.x) > _LDims.z || abs(q.y) > _LDims.z) break;
        tau += betaL(q) * s; a += s; s *= 1.6;
    }
    return exp(-0.1 * tau);
}

[numthreads(4, 4, 4)]
void SkyVis(uint3 gid : SV_DispatchThreadID)
{
    uint nv = (uint)_LDims.x; uint nz = (uint)_LDims.y;
    uint3 id = uint3(gid.x, gid.y, gid.z + (uint)_LSlab.x);
    if (id.x >= nv || id.y >= nv || id.z >= nz) return;
    float dx = 2.0 * _LDims.z / _LDims.x; float dz = _LDims.w / _LDims.y;
    float3 pos = float3(-_LDims.z + (id.x + 0.5) * dx, -_LDims.z + (id.y + 0.5) * dx, (id.z + 0.5) * dz);
    float zen = skyTrace(pos, float3(0.0, 0.0, 1.0));
    [unroll] for (int i = 0; i < 4; i++) { float a = i * 1.5708 + 0.7854; zen += skyTrace(pos, float3(cos(a) * 0.4226, sin(a) * 0.4226, 0.9063)); }
    float mid = 0.0;
    [unroll] for (int j = 0; j < 6; j++) { float a = j * 1.0472; mid += skyTrace(pos, float3(cos(a) * 0.766, sin(a) * 0.766, 0.6428)); }
    float hor = 0.0, hk = 0.0, wk = 0.0;
    float2 kd = normalize(_LSun.xy + float2(1e-5, 0.0));
    [unroll] for (int k = 0; k < 8; k++)
    {
        float a = k * 0.7854; float2 h = float2(cos(a), sin(a));
        float v = skyTrace(pos, float3(h * 0.9903, 0.1392));
        float w = max(dot(h, kd), 0.0); w *= w;
        hor += v; hk += w * v; wk += w;
    }
    _OutS[id] = float4(zen * 0.2, mid / 6.0, hor / 8.0, hk / max(wk, 1e-4));
}

// ------------------------------------------------------------------------------------------------ ground light
// How lit the ground is, averaged over the 4 km a cloud base above it sees (13 taps): r the sun's (or moon's)
// transmittance to the ground, g its sky from above. The march turns it into light bounced up onto cloud undersides.
RWTexture2D<float2> _OutG;
Texture3D<float4> _LightIn;

[numthreads(8, 8, 1)]
void GroundLight(uint3 id : SV_DispatchThreadID)
{
    uint nv = (uint)_LDims.x;
    if (id.x >= nv || id.y >= nv) return;
    float dx = 2.0 * _LDims.z / _LDims.x;
    float2 p = float2(-_LDims.z + (id.x + 0.5) * dx, -_LDims.z + (id.y + 0.5) * dx);
    float2 acc = 0.0;
    [unroll] for (int k = 0; k < 13; k++)
    {
        float r = k == 0 ? 0.0 : (k <= 6 ? 2.0 : 4.0);
        float a = k * 1.0472 + (k > 6 ? 0.5236 : 0.0);
        float4 l = _LightIn.SampleLevel(sampler_LinearClamp, luvw(float3(p + r * float2(cos(a), sin(a)), 0.05)), 0);
        acc += float2(sunT(l.r), l.g);
    }
    _OutG[id.xy] = acc / 13.0;
}

// ------------------------------------------------------------------------------------------------ wind reduction
StructuredBuffer<float> _MU;
StructuredBuffer<float> _MV;
StructuredBuffer<float> _MW;
// per 1 km layer: first and last cell-centre level (inclusive)
StructuredBuffer<int2> _LayerK;
RWStructuredBuffer<uint> _WindOut;
// NX, NY, NZ, block size in cells
int4 _WN;
// blocks x, blocks y, layers, 0
int4 _WB;

uint enc(float v) { return (uint)clamp(round((v + 51.0) / 0.4), 0.0, 255.0); }

[numthreads(8, 8, 1)]
void Wind(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _WB.x || (int)id.y >= _WB.y || (int)id.z >= _WB.z) return;
    int NX = _WN.x, NY = _WN.y, NZ = _WN.z, B = _WN.w;
    int2 kr = _LayerK[id.z];
    float su = 0, sv = 0, sw = 0, n = 0;
    int i0 = id.x * B, j0 = id.y * B;
    for (int k = kr.x; k <= kr.y; k++)
        for (int j = j0; j < min(j0 + B, NY); j++)
            for (int i = i0; i < min(i0 + B, NX); i++)
            {
                su += 0.5 * (_MU[(k * NY + j) * (NX + 1) + i] + _MU[(k * NY + j) * (NX + 1) + i + 1]);
                sv += 0.5 * (_MV[(k * (NY + 1) + j) * NX + i] + _MV[(k * (NY + 1) + j + 1) * NX + i]);
                sw += 0.5 * (_MW[(k * NY + j) * NX + i] + _MW[((k + 1) * NY + j) * NX + i]);
                n += 1;
            }
    n = max(n, 1);
    _WindOut[(id.z * _WB.y + id.y) * _WB.x + id.x] = enc(su / n) | (enc(sv / n) << 8) | (enc(sw / n) << 16) | (255u << 24);
}
