            bool inTor = false;
            if (torOn && q.z < torTop)
            {
                float dc = t < trIn ? trIn - t : (t <= trOut ? -1.0 : 1e9);
                float da = S_anti.w > 0.0 ? length(q.xy - antiP) - 0.4 : 1e9;
